# =====================================================================
# metadyn.inp  --  xTB 6.7.1 gas-phase metadynamics input
# ---------------------------------------------------------------------
# These are CONSERVATIVE INITIAL TESTING values, NOT universally correct
# production settings. The biasing strength (kpush, alp), the save count,
# the temperature and the total time generally require tuning for the
# specific molecular system and the process you want to enhance. Start
# gentle, inspect both xtb.trj and the scoord.* snapshots for unphysical
# dissociation, then adjust.
#
# Run with, e.g.:
#   xtb coord --md --input metadyn.inp --gfn 2 --chrg 0 --uhf 0 > output.log
# =====================================================================

$md
   temp=300         # thermostat target temperature in Kelvin
   time=20.0        # total simulation time in ps (short, for testing)
   step=1.0         # integration timestep in fs. Use 0.5 fs if H atoms
                    #   are involved and you do NOT constrain X-H bonds.
   dump=100.0       # full-trajectory (xtb.trj) dump interval in fs.
                    #   100 fs => ~1 frame / 0.1 ps, i.e. MUCH finer than
                    #   the ~1 ps scoord.* snapshots, so fast events are
                    #   captured in xtb.trj. Do NOT confuse this with the
                    #   scoord.* snapshot cadence (see notes below).
   hmass=1          # H mass scaling factor (1 = no scaling)
   shake=0          # 0 = no SHAKE constraints. Set shake=2 to constrain
                    #   all bonds and allow a larger timestep (step=2.0).
   nvt=true         # use a thermostat (canonical NVT ensemble)
$end

$metadyn
   save=10          # maximum number of structures RETAINED for the
                    #   RMSD-based bias criterion. This sets how many
                    #   reference geometries the bias is evaluated against;
                    #   it does NOT control the scoord.* write frequency,
                    #   and a larger value is not by itself "more
                    #   aggressive flooding" (the per-structure push
                    #   strength is set by kpush).
   kpush=0.02       # scaling factor controlling the STRENGTH of the
                    #   RMSD-based metadynamics bias. Larger kpush
                    #   increases the push away from previously visited
                    #   structures and increases the risk of unphysical
                    #   dissociation. This is the single most important
                    #   biasing knob; start small.
   alp=1.2          # controls the SHAPE / WIDTH of the RMSD-based bias
                    #   contribution. Smaller alp broadens the bias in
                    #   RMSD space (gentler, more diffuse); larger alp
                    #   narrows it.
$end

# ---------------------------------------------------------------------
# Notes:
#  * xTB's built-in metadynamics biases along the CARTESIAN RMSD between
#    the current structure and the retained reference structures. It does
#    NOT bias along the bond distances / angles you compute later in
#    analysis. Those structural descriptors are post-hoc observables.
#  * scoord.1, scoord.2, ... are PERIODIC COORDINATE SNAPSHOTS written at
#    approximately 1 ps intervals. They are NOT simply the set of
#    structures currently retained for the RMSD bias. The "save" keyword
#    governs the retained bias reference structures, not how often
#    scoord.* files are written.
#  * xtb.trj (controlled by "dump" above) is the dense full trajectory;
#    use it, not the sparse scoord.* set, for detailed transition
#    analysis.
#  * For a production run you will typically increase "time" and may
#    cautiously raise "kpush" once you have confirmed the system stays
#    intact at the smaller value.
# ---------------------------------------------------------------------
